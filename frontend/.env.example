# Copy to .env for local development. Vite only exposes variables prefixed VITE_ to client
# code — see https://vite.dev/guide/env-and-mode.

VITE_API_BASE_URL=http://localhost:8080/api

# ── Firebase Authentication (phone OTP + email sign-in) ──
# All PUBLIC — safe to ship to the browser, this is standard Firebase Web SDK config, not a
# secret (unlike the backend's FIREBASE_CREDENTIALS_JSON Admin SDK key, which must never be
# here). Leave every value blank to keep the Phone sign-in tab hidden and email/password
# login working exactly as before — Firebase is additive, not required.
#
# Firebase Console -> Project Settings -> General -> Your apps -> Web app -> SDK setup and
# configuration. Must be the SAME Firebase project as the backend's FIREBASE_CREDENTIALS_JSON,
# and Authentication -> Sign-in method -> Phone must be enabled there.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
