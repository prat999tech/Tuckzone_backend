# Copy to .env and fill in. Spring Boot does NOT auto-load .env files — load it into your
# shell before starting the app:
#
#   set -a && source .env && set +a && ./mvnw spring-boot:run
#
# Leave a value blank (or omit the line) to keep the safe development default from
# application.yml — e.g. leaving APP_OTP_DELIVERY unset keeps OTP in log/dev mode.

# ── Database (defaults already match docker-compose.dev.yml — usually leave these alone) ──
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/canteen
SPRING_DATASOURCE_USERNAME=canteen
SPRING_DATASOURCE_PASSWORD=canteen

# ── Security ──
# Generate a real one for anything beyond local dev: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789-abcdefghijklmnop
JWT_REFRESH_DAYS=60
# One-time code required to register a CANTEEN_ADMIN account (prevents takeover).
ADMIN_SIGNUP_CODE=CANTEEN-SETUP-2026

# ── OTP delivery: log (default, safe) or email (real, uses the provider settings below) ──
# Codes for registration, OTP sign-in and password reset all go by email. SMS was removed
# deliberately: it needs DLT registration in India plus a paid gateway, for no benefit here.
APP_OTP_DELIVERY=log
# Minimum gap enforced between two codes issued to the same address ("Resend" cooldown).
APP_OTP_RESEND_COOLDOWN_SECONDS=30

# ── Notification delivery ──
# push-provider: log (default) or firebase (needs a Firebase project + service account)
APP_PUSH_PROVIDER=log

# email-provider: log (default) or smtp — general notifications only (order receipts,
# refund/wallet confirmations, sign-in alerts). Auth email (OTP/verification/password
# reset for the legacy login) also goes through this. Amazon SES support was removed —
# point MAIL_HOST at SES's own SMTP interface (email-smtp.<region>.amazonaws.com:587,
# separate credentials generated in the SES console under "SMTP settings") if you still
# want SES as the relay, or use any other SMTP provider.
APP_EMAIL_PROVIDER=log

# --- smtp provider ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

EMAIL_FROM_ADDRESS=noreply@tuckzone.local
EMAIL_FROM_NAME="TuckZone Canteen"

# ── Firebase Authentication (phone OTP + email, additive alongside the login above) ──
# PRIVATE — Admin SDK credential, backend only, never sent to the frontend. Shared with
# push (APP_PUSH_PROVIDER=firebase above uses the same project/credential). Paste the
# service-account JSON's contents directly, or base64-encode it first if your host mangles
# multi-line env vars (Railway does not need base64; most others are safer with it).
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
FIREBASE_CREDENTIALS_JSON=

# PUBLIC — safe to expose to any client; this is standard Firebase Web SDK config, not a
# secret. Firebase Console -> Project Settings -> General -> Your apps -> Web app -> SDK
# setup and configuration. The frontend/mobile apps read their own copies of these (see
# frontend/.env.example and mobile/.env.example) — listed here only for reference since
# they all come from the same Firebase project as FIREBASE_CREDENTIALS_JSON above.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=

# ── Payment ──
# provider: mock (default, safe — no real money moves) or razorpay (real gateway).
# Adding another provider (Cashfree, Stripe, ...) never touches this list beyond one more
# name — see docs/payments/ADDING_A_NEW_PROVIDER.md.
APP_PAYMENT_PROVIDER=mock
APP_ALLOW_MOCK_TOPUP=true

# Only read when APP_PAYMENT_PROVIDER=razorpay. Test-mode keys from the Razorpay
# dashboard (Settings -> API Keys). Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configured separately in the dashboard's Webhooks section; verifies inbound webhook
# calls are genuinely from Razorpay.
RAZORPAY_WEBHOOK_SECRET=

# ── Misc ──
APP_SEED_ENABLED=false
FRONTEND_URL=http://localhost:5173,http://localhost:3000
