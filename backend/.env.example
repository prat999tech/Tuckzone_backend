# Copy to .env and fill in. Spring Boot does NOT auto-load .env files — load it into your
# shell before starting the app:
#
#   set -a && source .env && set +a && ./mvnw spring-boot:run
#
# Leave a value blank (or omit the line) to keep the safe development default from
# application.yml — e.g. leaving APP_OTP_DELIVERY unset keeps OTP in log/dev mode.

# ── Database (defaults already match docker-compose.dev.yml — usually leave these alone) ──
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/canteen
SPRING_DATASOURCE_USERNAME=canteen
SPRING_DATASOURCE_PASSWORD=canteen

# ── Security ──
# Generate a real one for anything beyond local dev: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789-abcdefghijklmnop
JWT_REFRESH_DAYS=60
# One-time code required to register a CANTEEN_ADMIN account (prevents takeover).
ADMIN_SIGNUP_CODE=CANTEEN-SETUP-2026

# ── OTP delivery: log (default, safe) or email (real, uses the SMTP settings below) ──
# Codes for registration, OTP sign-in and password reset all go by email. SMS was removed
# deliberately: it needs DLT registration in India plus a paid gateway, for no benefit here.
APP_OTP_DELIVERY=log

# ── Notification delivery ──
# push-provider: log (default) or firebase (needs a Firebase project + service account)
APP_PUSH_PROVIDER=log
FIREBASE_CREDENTIALS_JSON=
# email-provider: log (default) or smtp (real delivery)
# Plain SMTP — no vendor SDK, no lock-in. Works with any provider:
#   Gmail : MAIL_HOST=smtp.gmail.com  MAIL_PORT=587
#           MAIL_USERNAME=you@gmail.com
#           MAIL_PASSWORD=<16-char Google "App Password", NOT your account password;
#                          requires 2-Step Verification enabled on the Google account>
#   Zoho  : MAIL_HOST=smtp.zoho.in    MAIL_PORT=587
#   SES   : MAIL_HOST=email-smtp.<region>.amazonaws.com  MAIL_PORT=587
APP_EMAIL_PROVIDER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@tuckzone.local
EMAIL_FROM_NAME="TuckZone Canteen"

# ── Payment (kept mocked until a real gateway is integrated — see PaymentProperties) ──
APP_ALLOW_MOCK_TOPUP=true

# ── Misc ──
APP_SEED_ENABLED=false
FRONTEND_URL=http://localhost:5173,http://localhost:3000
