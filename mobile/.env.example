# Copy to .env and fill in for your setup.
#
# Android emulator reaches your computer's localhost via the special address 10.0.2.2.
# A physical phone on the same wifi needs your computer's LAN IP instead (e.g. 192.168.1.42).
# In production, point this at the deployed Render URL.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api
